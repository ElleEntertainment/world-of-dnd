{
    "version": 2,
    "buildCommand": "npm run prisma:generate",
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/main.ts",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS"
            ],
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        }
    ],
    "crons": [
        {
            "path": "/heartbeat/ping",
            "schedule": "0 10 * * *"
        }
    ]
}