{{!< ../layout}}
<div>
  <h2 class="text-2xl font-semibold mb-4 content-heading">Utenti Registrati</h2>

  <div id="list" class="space-y-3"></div>
</div>

  <script>
  const apiBase = '/admin/api';

  // Prefer cookie-based auth (HttpOnly cookie set by /admin/set-token).
  // When running client-side JS include credentials:'include' so cookies are sent.
  // Keep fallback to Authorization header from localStorage for non-HttpOnly flows.
  const authHeader = () => {
    const t = localStorage.getItem('access_token');
    return t ? { 'Authorization': 'Bearer ' + t } : {};
  };

  async function fetchUsers() {
    const res = await fetch(apiBase + '/users', { credentials: 'include', headers: { ...authHeader() } });
    if (!res.ok) return document.getElementById('list').innerText = 'Errore caricamento';
    const data = await res.json();
    renderList(data);
  }

  function renderList(users) {
    const container = document.getElementById('list');
    container.innerHTML = '';
    for (const u of users) {
      const el = document.createElement('div');
      el.className = 'card p-3 rounded flex items-center justify-between';
      el.innerHTML = `
        <div>
          <div class="font-medium text-slate-100">${escapeHtml(u.email)} <span class="text-sm text-slate-400">#${u.id}</span></div>
          <div class="text-sm text-slate-300">${escapeHtml(u.name || '')} — ${new Date(u.createdAt).toLocaleString()}</div>
        </div>
        
      `;
      container.appendChild(el);
    }
    
  }

  function escapeHtml(text) {
    return (''+text).replace(/[&<>"']/g, s => ({'&':'&','<':'<','>':'>','"':'"',"'":"&#39;"}[s]));
  }

  // Initial load
  fetchUsers();
</script>
